---
layout: layouts/base.njk
---
{#
  Generic page builder. Each page lists its sections in front matter.
  Section types: hero, text, split, cards, steps, faq, list, embed, cta, ticker, quote
  Any "img" value is a key in src/_data/images.json.
  Any "url" starting with "/" is a page on this site.
#}
{% import "macros.njk" as m with context %}
{% macro btn(b, style) %}{% if b %}<a class="pill pill--{{ b.style or style }}" href="{{ b.url | url }}">{{ b.label }} <span class="pill__arrow" aria-hidden="true">→</span></a>{% endif %}{% endmacro %}
{% macro head(s, centre) %}
  {% if s.eyebrow %}{{ m.eyebrow(s.eyebrow) }}{% endif %}
  {% if s.heading %}<h2>{{ s.heading | safe }}</h2>{% endif %}
{% endmacro %}
{% macro body(s) %}
  {% for p in s.text %}<p>{{ p | safe }}</p>{% endfor %}
  {% if s.bullets %}<ul class="stars">{% for b in s.bullets %}<li>{{ b | safe }}</li>{% endfor %}</ul>{% endif %}
  {% if s.buttons %}<p class="btns">{% for b in s.buttons %}{{ btn(b, "dark") }}{% endfor %}</p>{% endif %}
  {% if s.links %}<p class="links">{% for l in s.links %}<a class="arrow-link" href="{{ l.url | url }}">{{ l.label }} <span aria-hidden="true">→</span></a>{% endfor %}</p>{% endif %}
{% endmacro %}

{% for s in sections | withBg %}
{% set bg = s._bg %}

{% if s.type == "hero" %}
<section class="hero{% if s.big %}{% if s.short %} hero--short{% endif %}{% else %} hero--simple{% endif %}">
  {% if s.video %}<video class="hero__img hero__video" autoplay muted loop playsinline preload="metadata" poster="{{ ('/assets/img/' + images[s.img].file) | url }}"><source src="{{ s.video }}" type="video/mp4"></video>
  <button class="hero__pause" type="button" aria-label="Pause video" data-video-toggle>❚❚</button>
  {% else %}{{ m.photo(s.img, "hero__img", true) }}{% endif %}
  <div class="hero__inner">
    {% if s.logo %}<img class="hero__logo" src="{{ ('/assets/img/' + images[s.logo].file) | url }}" alt="{{ images[s.logo].alt }}">{% endif %}
    {% if s.eyebrow and s.big %}{{ m.eyebrow(s.eyebrow) }}{% endif %}
    <h1 class="hero__title">{{ s.title | safe }}</h1>
    <div class="hero__foot">
      {% if s.intro %}<p class="hero__intro">{{ s.intro | safe }}</p>{% endif %}
      <div class="hero__actions">
        {% if s.times %}<ul class="times">{% for t in site.timesList %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
        <div class="btns">{% for b in s.buttons %}{{ btn(b, "light") }}{% endfor %}</div>
      </div>
    </div>
    {% if s.chips %}<ul class="hero__chips">{% for c in s.chips %}<li>{% if c.url %}<a href="{{ c.url | url }}">{{ c.label }}</a>{% else %}{{ c }}{% endif %}</li>{% endfor %}</ul>{% endif %}
    {% if s.note %}<p class="hero__note">{{ s.note | safe }}</p>{% endif %}
  </div>
</section>

{% elif s.type == "ticker" %}
<div class="ticker" aria-label="{{ s.items | join(', ') }}"><div class="ticker__track" aria-hidden="true">{% for round in [1, 2] %}{% for t in s.items %}<span>{{ t }} ✦</span>{% endfor %}{% endfor %}</div></div>

{% elif s.type == "text" %}
<section class="sec{{ bg }}" {% if s.id %}id="{{ s.id }}"{% endif %}>
  {% if s.centre %}
  <div class="centre-head">{{ head(s) }}<div class="lede-block">{{ body(s) }}</div></div>
  {% else %}
  <div class="split-head split-head--text"><div>{{ head(s) }}</div><div>{{ body(s) }}</div></div>
  {% endif %}
</section>

{% elif s.type == "split" %}
<section class="sec{{ bg }}" {% if s.id %}id="{{ s.id }}"{% endif %}>
  <div class="plan{% if s.flip %} plan--flip{% endif %}">
    {{ m.photo(s.img, "plan__img" + (" plan__img--logo" if s.logo else "")) }}
    <div>{{ head(s) }}{{ body(s) }}</div>
  </div>
</section>

{% elif s.type == "cards" %}
<section class="sec{{ bg }}" {% if s.id %}id="{{ s.id }}"{% endif %}>
  {% if s.heading or s.eyebrow %}<div class="centre-head">{{ head(s) }}{% if s.intro %}<p class="lede">{{ s.intro | safe }}</p>{% endif %}</div>{% endif %}
  <div class="gcards gcards--{{ s.cols or 3 }}{% if s.portraits %} gcards--portraits{% endif %}{% if s.logos %} gcards--logos{% endif %}">
    {% for c in s.cards %}
    <article class="gcard{% if c.img %} gcard--img{% endif %}">
      {% if c.video %}<div class="embed embed--card"><iframe src="https://www.youtube-nocookie.com/embed/{{ c.video }}" title="{{ c.title }}" loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe></div>{% endif %}
      {% if c.img %}<div class="gcard__media">{{ m.photo(c.img, "gcard__img") }}{% if c.badge %}<p class="badge">{{ c.badge }}</p>{% endif %}</div>{% endif %}
      <div class="gcard__body">
        {% if c.eyebrow %}<p class="gcard__eyebrow">{{ c.eyebrow | safe }}</p>{% endif %}
        <h3>{{ c.title | safe }}</h3>
        {% if c.meta %}<p class="gcard__meta">{{ c.meta | safe }}</p>{% endif %}
        {% for p in c.text %}<p>{{ p | safe }}</p>{% endfor %}
        {% if c.bullets %}<ul class="stars">{% for b in c.bullets %}<li>{{ b | safe }}</li>{% endfor %}</ul>{% endif %}
        {% if c.url %}<a class="arrow-link" href="{{ c.url | url }}">{{ c.link or "Find out more" }} <span aria-hidden="true">→</span></a>{% endif %}
        {% for l in c.links %}<a class="arrow-link" href="{{ l.url | url }}">{{ l.label }} <span aria-hidden="true">→</span></a> {% endfor %}
      </div>
    </article>
    {% endfor %}
  </div>
  {% if s.buttons %}<p class="btns btns--centre">{% for b in s.buttons %}{{ btn(b, "dark") }}{% endfor %}</p>{% endif %}
</section>

{% elif s.type == "gallery" %}
<section class="sec{{ bg }}">
  <div class="livegallery__grid livegallery__grid--even">{% for i in s.imgs %}{{ m.photo(i, "") }}{% endfor %}</div>
</section>

{% elif s.type == "steps" %}
<section class="sec{{ bg }}">
  <div class="centre-head">{{ head(s) }}{% if s.intro %}<p class="lede">{{ s.intro | safe }}</p>{% endif %}</div>
  <ol class="steps">
    {% for st in s.steps %}
    <li class="step">
      {% if st.img %}<div class="step__media">{{ m.photo(st.img, "step__img") }}<span class="step__num">0{{ loop.index }}</span></div>{% else %}<span class="room__num">0{{ loop.index }}</span>{% endif %}
      <h3>{{ st.title }}</h3>
      {% for p in st.text %}<p>{{ p | safe }}</p>{% endfor %}
      {% if st.url %}<a class="arrow-link" href="{{ st.url | url }}">{{ st.link or "Find out more" }} <span aria-hidden="true">→</span></a>{% endif %}
    </li>
    {% endfor %}
  </ol>
</section>

{% elif s.type == "faq" %}
<section class="sec{{ bg or ' sec--linen' }} faq">
  <div class="faq__head">{{ head(s) }}{% for p in s.text %}<p>{{ p | safe }}</p>{% endfor %}</div>
  <div class="faq__list">{% for f in s.faqs %}<details><summary>{{ f.q }}</summary>{% for p in f.a %}<p>{{ p | safe }}</p>{% endfor %}</details>{% endfor %}</div>
</section>

{% elif s.type == "include" %}
<section class="sec-raw">{% include s.file %}</section>

{% elif s.type == "embed" %}
<section class="sec{{ bg }}">
  {% if s.heading or s.eyebrow %}<div class="centre-head">{{ head(s) }}{% if s.intro %}<p class="lede">{{ s.intro | safe }}</p>{% endif %}</div>{% endif %}
  {%- set latest = messages[0] if (s.latest and messages and messages.length) else null -%}
  <div class="embed{% if s.ratio %} embed--{{ s.ratio }}{% endif %}"><iframe src="{{ ('https://www.youtube-nocookie.com/embed/' + latest.id + '?rel=0') if latest else s.src }}" title="{{ latest.title if latest else (s.title or s.heading or 'Embedded content') }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe></div>
  {% if latest %}<p class="embed__caption">{{ latest.title }}{% for p in collections.posts %}{% if p.data.video == latest.id %} · <a href="{{ p.url | url }}">Read the summary and group questions</a>{% endif %}{% endfor %}</p>{% endif %}
  {% if s.buttons %}<p class="btns btns--centre">{% for b in s.buttons %}{{ btn(b, "dark") }}{% endfor %}</p>{% endif %}
</section>

{% elif s.type == "videos" %}
<section class="sec{{ bg }}" {% if s.id %}id="{{ s.id }}"{% endif %}>
  {% if s.heading or s.eyebrow %}<div class="centre-head">{{ head(s) }}{% if s.intro %}<p class="lede">{{ s.intro | safe }}</p>{% endif %}</div>{% endif %}
  {% if messages and messages.length %}
  <div class="vids">
    {% for v in messages %}
    <article class="vid">
      <div class="embed"><iframe src="https://www.youtube-nocookie.com/embed/{{ v.id }}?rel=0" title="{{ v.title }}" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe></div>
      <h3>{{ v.title }}</h3>
      {% for p in collections.posts %}{% if p.data.video == v.id %}<a class="vid__more" href="{{ p.url | url }}">Read the summary and group questions <span aria-hidden="true">→</span></a>{% endif %}{% endfor %}
    </article>
    {% endfor %}
  </div>
  {% else %}
  <div class="embed"><iframe src="{{ s.fallback }}" title="{{ s.heading }}" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe></div>
  {% endif %}
  {% if s.buttons %}<p class="btns btns--centre">{% for b in s.buttons %}{{ btn(b, "dark") }}{% endfor %}</p>{% endif %}
</section>

{% elif s.type == "sermons" %}
{%- set sermons = [] -%}
{%- for p in collections.posts -%}{% if p.data.label == "Sermon" and sermons.length < (s.count or 3) %}{% set sermons = (sermons.push(p), sermons) %}{% endif %}{%- endfor -%}
{% if sermons.length %}
<section class="sec sermons"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="sermons__head">
    <div>{% if s.eyebrow %}{{ m.eyebrow(s.eyebrow) }}{% endif %}<h2>{{ s.heading or "Sermon summaries" }}</h2>{% if s.intro %}<p>{{ s.intro | safe }}</p>{% endif %}</div>
    <a class="sermons__all" href="{{ '/blog/' | url }}?label=sermon">All sermon summaries <span aria-hidden="true">→</span></a>
  </div>
  <div class="prows">{% for p in sermons %}{{ m.postRow(p) }}{% endfor %}</div>
</section>
{% endif %}

{% elif s.type == "quote" %}
<section class="sec{{ bg or ' sec--linen' }} welcome{% if s.avatar %} welcome--avatar{% endif %}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  {% if not s.avatar %}<div class="welcome__media">{{ m.photo(s.img, "welcome__img") }}</div>{% endif %}
  <div class="welcome__text">
    {% if s.eyebrow %}{{ m.eyebrow(s.eyebrow) }}{% endif %}
    {% if s.quote %}<blockquote>{{ s.quote | safe }}</blockquote>{% endif %}
    {% for p in s.text %}<p>{{ p | safe }}</p>{% endfor %}
    {% if s.sig and s.avatar %}<div class="sig sig--avatar">{{ m.photo(s.img, "sig__img") }}<p class="sig__text"><span class="script">{{ s.sig }}</span>{% if s.role %}<span>{{ s.role }}</span>{% endif %}</p></div>
    {% elif s.sig %}<p class="sig"><span class="script">{{ s.sig }}</span>{% if s.role %}<span>{{ s.role }}</span>{% endif %}</p>{% endif %}
    {% if s.buttons %}<p class="btns">{% for b in s.buttons %}{{ btn(b, "dark") }}{% endfor %}</p>{% endif %}
  </div>
</section>

{% elif s.type == "csgroups" %}
<section class="sec{{ bg }}" data-cs-groups data-fallback="{{ s.fallback }}">
  {% if s.heading %}<div class="centre-head">{{ head(s) }}{% if s.intro %}<p class="lede">{{ s.intro | safe }}</p>{% endif %}</div>{% endif %}
  <div class="cs-tools"><input class="cs-search" type="search" placeholder="Search groups" aria-label="Search groups"><select class="cs-day" aria-label="Filter by day"><option value="">Any day</option></select>{% for b in s.buttons %}{{ btn(b, "dark") }}{% endfor %}</div>
  <p class="cs-status">Loading groups…</p>
  <div class="gcards gcards--3 cs-list"></div>
</section>

{% elif s.type == "csevents" %}
<section class="sec{{ bg }}" data-cs-events data-fallback="{{ s.fallback }}"{% if s.hideSundays %} data-hide-sundays{% endif %}>
  {% if s.heading %}<div class="centre-head">{{ head(s) }}{% if s.intro %}<p class="lede">{{ s.intro | safe }}</p>{% endif %}</div>{% endif %}
  <p class="cs-status">Loading events…</p>
  <div class="gcards gcards--3 cs-list"></div>
  {% if s.buttons %}<p class="btns btns--centre">{% for b in s.buttons %}{{ btn(b, "dark") }}{% endfor %}</p>{% endif %}
</section>

{% elif s.type == "stats" %}
<section class="sec{{ bg }}">
  <div class="centre-head">{{ head(s) }}{% if s.intro %}<p class="lede">{{ s.intro | safe }}</p>{% endif %}</div>
  <dl class="stats">{% for st in s.stats %}<div><dt>{{ st.label | safe }}</dt><dd>{{ st.value }}</dd></div>{% endfor %}</dl>
  {% if s.small %}<p class="stats__note">{{ s.small | safe }}</p>{% endif %}
</section>

{% elif s.type == "bank" %}
<section class="sec{{ bg }}" {% if s.id %}id="{{ s.id }}"{% endif %}>
  <div class="centre-head">{{ head(s) }}{% if s.intro %}<p class="lede">{{ s.intro | safe }}</p>{% endif %}</div>
  <div class="gcards gcards--3 bank">
    {% for a in s.accounts %}
    <article class="gcard"><div class="gcard__body">
      <h3>{{ a.name }}</h3>
      <dl class="bank__rows">
        <div><dt>BSB</dt><dd><span>{{ a.bsb }}</span><button type="button" class="copy" data-copy="{{ a.bsb | replace(' ', '') }}" aria-label="Copy {{ a.name }} BSB">Copy</button></dd></div>
        <div><dt>Account</dt><dd><span>{{ a.acc }}</span><button type="button" class="copy" data-copy="{{ a.acc | replace(' ', '') }}" aria-label="Copy {{ a.name }} account number">Copy</button></dd></div>
      </dl>
      {% if a.link %}<a class="arrow-link" href="{{ a.link.url | url }}">{{ a.link.label }} <span aria-hidden="true">→</span></a>{% endif %}
    </div></article>
    {% endfor %}
  </div>
  {% if s.text %}<div class="centre-head bank__after">{% for p in s.text %}<p>{{ p | safe }}</p>{% endfor %}</div>{% endif %}
  {% if s.buttons %}<p class="btns btns--centre">{% for b in s.buttons %}{{ btn(b, "dark") }}{% endfor %}</p>{% endif %}
</section>

{% elif s.type == "cta" %}
<section class="sec closing{{ bg }}">
  {% if s.eyebrow %}{{ m.eyebrow(s.eyebrow) }}{% endif %}
  <h2>{{ s.heading | safe }}</h2>
  {% for p in s.text %}<p class="closing__text">{{ p | safe }}</p>{% endfor %}
  <p class="btns btns--centre">{% for b in s.buttons %}{{ btn(b, "dark") }}{% endfor %}</p>
  {% if s.small %}<p class="closing__line">{{ s.small | safe }}</p>{% endif %}
</section>
{% endif %}
{% endfor %}
<script>
document.querySelectorAll("[data-copy]").forEach(function(b){b.addEventListener("click",function(){navigator.clipboard&&navigator.clipboard.writeText(b.dataset.copy).then(function(){var t=b.textContent;b.textContent="Copied";setTimeout(function(){b.textContent=t},1500)})})});
document.querySelectorAll("[data-video-toggle]").forEach(function(b){var v=b.parentNode.querySelector("video");if(matchMedia("(prefers-reduced-motion: reduce)").matches){v.pause();v.removeAttribute("autoplay");b.textContent="▶";b.setAttribute("aria-label","Play video")}b.addEventListener("click",function(){if(v.paused){v.play();b.textContent="❚❚";b.setAttribute("aria-label","Pause video")}else{v.pause();b.textContent="▶";b.setAttribute("aria-label","Play video")}})});
</script>
{% if usesChurchSuite %}<script src="{{ '/assets/js/churchsuite.js' | url }}" defer></script>{% endif %}
