---
layout: layouts/base.njk
title: Sundays | Lifepoint Church - Moreton, Queensland
description: Sundays at Lifepoint Church. Rothwell at 8.30am, 10am and 5pm. Caboolture West at 9.30am from 7 February 2027.
permalink: /sundays/
heroHeader: true
---
{% import "macros.njk" as m with context %}

<section class="hero hero--simple hero--pick">
  {{ m.photo("sundays-hero", "hero__img", true) }}
  <div class="hero__inner">
    <h1 class="hero__title">Sundays</h1>
    <div class="hero__foot">
      <p class="hero__intro">One church, two locations. Choose the one closest to you.</p>
    </div>
  </div>
</section>

<section class="sec sec--dark locpick" id="locations">
  <div class="campuses campuses--pick">
    {% for l in locations %}
    <article class="campus campus--link">
      <div class="campus__media">
        <a href="{{ ('/sundays/' + l.slug + '/') | url }}" tabindex="-1" aria-hidden="true">{{ m.photo(l.cardImg, "campus__img") }}</a>
        {% if l.note %}<p class="badge"><span>Launching</span> 7 Feb 2027</p>{% endif %}
      </div>
      <div class="campus__body">
        <h3><a class="campus__title" href="{{ ('/sundays/' + l.slug + '/') | url }}">{{ l.name }}</a></h3>
        <p class="campus__times">Sundays {{ l.times | join(" · ") }}</p>
        <p><strong>{{ l.venue }}</strong><br>{{ l.address }}</p>
        <div class="campus__btns">
          <a class="pill pill--blue campus__main" href="{{ ('/sundays/' + l.slug + '/') | url }}">Sundays at {{ l.name }} <span class="pill__arrow" aria-hidden="true">→</span></a>
          <a class="campus__dir" href="{{ l.maps }}">Get directions</a>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="sec pickhelp">
  <h2>Not sure which?</h2>
  <p>Let us know you're coming and we'll help you find your Sunday.</p>
  {{ m.pill("Plan your visit", site.planVisit, "dark") }}
</section>

<script>
document.querySelectorAll('.campus--link').forEach(function (card) {
  card.addEventListener('click', function (e) {
    if (e.target.closest('a')) return;
    var main = card.querySelector('.campus__main');
    if (main) window.location = main.href;
  });
});
</script>
