---
layout: layouts/base.njk
title: Home | Lifepoint Church - Moreton, Queensland
description: Lifepoint Church in Moreton Bay. Sundays at Rothwell (8.30am, 10am and 5pm) and Caboolture West (9.30am). Your place to belong.
permalink: /
heroHeader: true
firstSunday:
  - { title: Arrive, img: sundays-step-arrive, text: "Aim for about 10 minutes early. Our welcome team will meet you at the door and help you find your way." }
  - { title: If you have kids, img: sundays-step-kids, text: "Our Lifepoint Kids team will check your children in, get them settled and show you where to pick them up." }
  - { title: Gather, img: sundays-step-gather, text: "We sing, pray and hear a message from the Bible. The whole service runs for about 65 minutes." }
  - { title: Stay for a coffee, img: sundays-step-coffee, text: "Stick around afterwards for a coffee. It's the easiest way to meet a few people." }
videos:
  - { video: jqyPt60bXZ0, title: "A message from Dan", text: "Full, But Starving" }
  - { video: o1SLuRvRJjE, title: "Desmond's story", text: "How Desmond found his place at Lifepoint" }
steps:
  - { img: p-alpha-guest, title: Try Alpha, text: "Food, a short talk and honest conversation about life and faith. Questions welcome.", links: [{ label: Alpha, url: /alpha/ }] }
  - { img: home-groups, title: Find a group, text: "We meet in small groups through the week. Find one that fits your age, stage and interests.", links: [{ label: Find a group, url: /small-groups/ }] }
  - { img: home-faith-steps, title: Faith steps, text: "Exploring faith, getting baptised or wanting to go deeper? Find your next step.", links: [{ label: Next steps, url: /next-steps/ }] }
  - { img: home-serve, title: Serve, text: "The best way to find your place is to use your gifts on a Lifepoint team.", links: [{ label: Join a team, url: /teams/ }] }
  - { img: home-connect, title: Prayer, text: "Let us know how we can be praying for you.", links: [{ label: Prayer, url: /prayer/ }] }
---
{% import "macros.njk" as m with context %}

<section class="hhero">
  <video class="hhero__img" autoplay muted loop playsinline poster="{{ '/assets/img/home-hero-poster.jpg' | url }}"><source src="{{ '/assets/img/home-hero.mp4' | url }}" type="video/mp4"></video>
  <div class="hhero__inner">
    <h1 class="hhero__title">Welcome to Lifepoint <span class="script">your place to belong</span></h1>
    <div class="hhero__foot">
      <div class="hhero__where">
      <p class="hhero__label">One church · two locations</p>
      <ul class="hhero__locs">
        {% for l in locations %}<li><a class="hhero__loc" href="{{ ('/sundays/' + l.slug + '/') | url }}"><strong>{{ l.name }}{% if l.note %}<small class="hhero__soon">From 7 Feb 2027</small>{% endif %}</strong><span class="times">{% for t in l.times %}<span>{{ t }}</span>{% endfor %}</span><span class="hhero__go" aria-hidden="true">→</span></a></li>{% endfor %}
      </ul>
      </div>
      <div class="btns">
        <a class="pill pill--blue" href="{{ '/sundays/' | url }}">Plan your visit</a>
        <a class="pill pill--blue pill--clear" href="{{ '/watch--listen/' | url }}"><svg class="pill__play" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>Watch online</a>
      </div>
    </div>
  </div>
</section>

<section class="sec sec--linen" id="first-sunday">
  <div class="centre-head">
    {{ m.eyebrow("Your first Sunday") }}
    <h2>Here's what to expect.</h2>
    <p class="lede">No church experience required. Come as you are and we'll help you find your way.</p>
  </div>
  <ol class="steps steps--compact">
    {% for s in firstSunday %}
    <li class="step">
      <div class="step__media">{{ m.photo(s.img, "step__img") }}<span class="step__num">0{{ loop.index }}</span></div>
      <h3>{{ s.title }}</h3>
      <p>{{ s.text }}</p>
    </li>
    {% endfor %}
  </ol>
  <p class="btns btns--centre">{{ m.pill("Plan your visit", "/sundays/", "dark") }}</p>
</section>

<section class="sec sec--nextgen kids">
  <div class="kids__text">
    {{ m.eyebrow("Lifepoint Kids") }}
    <h2>Your kids will love it here.</h2>
    <dl class="groups">
      <div><dt>Tots</dt><dd>18 months to Kindy age</dd></div>
      <div><dt>Kids Crew Jnr</dt><dd>Kindy and Prep</dd></div>
      <div><dt>Kids Crew</dt><dd>Years 1 to 6</dd></div>
    </dl>
    <ul class="stars">
      <li>Safe, simple check-in when you arrive</li>
      <li>Every leader holds a Blue Card and completes child-safe training</li>
      <li>Pre-register online to skip the forms on the day</li>
    </ul>
    <p class="btns">{{ m.pill("Pre-register your kids", site.kidsRego, "dark") }}<a class="arrow-link" href="{{ '/kids/' | url }}">More about Kids <span aria-hidden="true">→</span></a></p>
  </div>
  <div class="kids__collage">
    {% for i in ["sundays-kids-1", "sundays-kids-2", "sundays-kids-3"] %}{{ m.photo(i, "collage__img") }}{% endfor %}
  </div>
</section>

<section class="sec sec--dark">
  <div class="centre-head">
    {{ m.eyebrow("See what it's like") }}
    <h2>Have a look before you come.</h2>
    <p class="lede">Hear a message from Dan, or from someone who's found their place at Lifepoint.</p>
  </div>
  <div class="vids">
    {% for v in videos %}
    <article class="vid">
      <div class="embed"><iframe src="https://www.youtube-nocookie.com/embed/{{ v.video }}?rel=0" title="{{ v.title }}" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe></div>
      <h3>{{ v.title }}</h3>
      <p>{{ v.text }}</p>
    </article>
    {% endfor %}
  </div>
  <p class="btns btns--centre">{{ m.pill("More messages", "/watch--listen/", "light") }}</p>
</section>

<section class="sec sec--linen hletter">
  {{ m.photo("home-dan-steph", "hletter__img") }}
  <p class="hletter__kicker">A welcome from our Senior Pastors</p>
  <h2>You're welcome in our family</h2>
  <p>Every person matters to God, and you're welcome here whatever your beliefs, doubts, past or problems. We'd love to meet you on Sunday.</p>
  <p class="hletter__sig script">Dan and Steph Sweetman</p>
  {{ m.pill("Read Dan's welcome", "/our-team/#welcome", "dark") }}
</section>

<section class="sec sec--linen hrow" id="explore">
  <div class="centre-head">
    {{ m.eyebrow("Take a step") }}
    <h2>Already coming? Here's what's next.</h2>
  </div>
  <div class="htiles htiles--scroll">
    {% for t in steps %}
    <article class="htile">
      {{ m.photo(t.img, "htile__img") }}
      <div class="htile__body">
        <h3>{{ t.title | safe }}</h3>
        <p>{{ t.text }}</p>
        <p class="htile__btns">{% for b in t.links %}<a class="pill pill--light" href="{{ b.url | url }}">{{ b.label }}</a>{% endfor %}</p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

{% include "embeds/home-events.html" %}

<section class="hband">
  {{ m.photo("home-see-you-sunday", "hband__img") }}
  <div class="hband__inner">
    <h2>See you Sunday?</h2>
    <p class="hband__note">No church experience required.</p>
    <p>Sundays at Rothwell at 8.30am, 10am and 5pm, and at Caboolture West at 9.30am from 7 February 2027.</p>
    {{ m.pill("Sundays info", "/sundays/", "light") }}
  </div>
</section>
