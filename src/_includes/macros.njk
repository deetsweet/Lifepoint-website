{# Photo from the images list. Falls back to a placeholder until a file is added. #}
{% macro photo(key, cls="", eager=false) %}
{%- set p = images[key] -%}
{%- if p and p.file -%}
<img class="{{ cls }}" src="{{ ('/assets/img/' + p.file) | url }}" alt="{{ p.alt }}"{% if p.pos %} style="object-position: {{ p.pos }}"{% endif %}{% if not eager %} loading="lazy"{% endif %} decoding="async">
{%- else -%}
<div class="ph {{ cls }}" role="img" aria-label="{{ p.alt if p else key }}"><span>{{ p.alt if p else key }}</span></div>
{%- endif -%}
{% endmacro %}

{# Pill button with the round arrow badge #}
{% macro pill(label, href, style="light") %}
<a class="pill pill--{{ style }}" href="{{ href | url }}">{{ label }} <span class="pill__arrow" aria-hidden="true">→</span></a>
{% endmacro %}

{# Eyebrow line #}
{% macro eyebrow(text) %}<p class="eyebrow">{{ text | replace(" · ", "&nbsp;· ") | safe }}</p>{% endmacro %}

{# Blog post row: text first (label, date, title, summary, author), small thumbnail on the right #}
{% macro postCard(p) %}
{%- set a = authors[p.data.author] -%}
<a class="bcard" href="{{ p.url | url }}" data-label="{{ p.data.label | slugify }}">
  <div class="bcard__body">
    <p class="bcard__meta"><span class="bcard__label">{{ p.data.label }}</span><time datetime="{{ p.date | isoDate }}">{{ p.date | readableDate }}</time></p>
    <h3>{{ p.data.title }}</h3>
    <p class="bcard__excerpt">{{ p.data.excerpt }}</p>
    {% if a %}<p class="bcard__by">{{ photo(a.img, "bcard__avatar") }}<span>{{ a.name }}</span></p>{% endif %}
  </div>
  {%- if p.data.img or p.data.video %}
  <div class="bcard__thumb">{% if p.data.img %}{{ photo(p.data.img, "bcard__img") }}{% else %}<img class="bcard__img" src="https://i.ytimg.com/vi/{{ p.data.video }}/mqdefault.jpg" alt="" loading="lazy">{% endif %}</div>
  {%- endif %}
</a>
{% endmacro %}

{# Compact blog row: small thumbnail, label and date, title #}
{% macro postRow(p) %}
<a class="prow" href="{{ p.url | url }}">
  <span class="prow__thumb">{%- if p.data.img %}{{ photo(p.data.img, "prow__img") }}{% elif p.data.video %}<img class="prow__img" src="https://i.ytimg.com/vi/{{ p.data.video }}/mqdefault.jpg" alt="" loading="lazy">{% endif -%}</span>
  <span class="prow__text">
    <span class="prow__meta">{{ p.data.label }} · <time datetime="{{ p.date | isoDate }}">{{ p.date | readableDate }}</time></span>
    <span class="prow__title">{{ p.data.title }}</span>
  </span>
</a>
{% endmacro %}
