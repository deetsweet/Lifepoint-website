<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  {%- set shareTitle = title | replace(" | Lifepoint Church - Moreton, Queensland", "") -%}
  {%- set ogKey = ogImage or (sections[0].img if sections and sections[0].img) -%}
  {%- set shareImg = site.url + "/assets/img/" + ((images[ogKey].file if ogKey and images[ogKey] and images[ogKey].file) or site.shareImg) -%}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Lifepoint Church">
  <meta property="og:locale" content="en_AU">
  <meta property="og:title" content="{{ shareTitle }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ shareImg }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#333333">
  {% if not noindex %}{% include "schema.njk" %}{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Lato:ital,wght@0,300;0,400;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}?v={{ buildId }}">
  <link rel="icon" href="{{ '/assets/logo/lifepoint-badge-grey.svg' | url }}" type="image/svg+xml">
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>

  <header class="hdr{% if heroHeader %} hdr--over{% endif %}">
    <a class="hdr__logo" href="{{ '/' | url }}"><img src="{{ '/assets/logo/lifepoint-secondary-white.svg' | url }}" alt="Lifepoint Church" width="240" height="31"></a>
    <nav class="hdr__quick" aria-label="Quick links">
      {% for l in site.quickNav %}<a href="{{ l.url | url }}">{{ l.label }}</a>{% endfor %}
    </nav>
    <button class="hdr__burger" aria-expanded="false" aria-controls="menu" aria-label="Open navigation menu"><span></span><span></span></button>
  </header>

  <div class="menu" id="menu" hidden>
    <nav aria-label="Main menu">
      <ul>
        {% for item in site.menu %}
        <li>
          {% if item.children %}
          <details>
            <summary>{{ item.label }}</summary>
            <ul>{% for c in item.children %}<li><a href="{{ c.url | url }}">{{ c.label }}</a></li>{% endfor %}</ul>
          </details>
          {% else %}
          <a href="{{ item.url | url }}">{{ item.label }}</a>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="ftr">
    <div class="ftr__top">
      <div class="ftr__brand">
        <a class="ftr__logo" href="{{ '/' | url }}"><img src="{{ '/assets/logo/lifepoint-primary-white.svg' | url }}" alt="Lifepoint Church" width="150" height="100" loading="lazy"></a>
        <h2>{{ site.slogan }}</h2>
        <a class="pill pill--light" href="{{ '/sundays/' | url }}">Plan your visit <span class="pill__arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="ftr__info">
        {% for l in locations %}<p><strong>{{ l.name }} · Sundays {{ l.timesText }}</strong><br>{{ l.venue }}, {{ l.address }}{% if l.note %}<br>From 7 February 2027{% endif %}</p>{% endfor %}
        <p><strong>Get in touch</strong><br><a href="mailto:{{ site.email }}">{{ site.email }}</a><br><a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a></p>
        <p><strong>{{ site.office.label }}</strong><br>{% for line in site.office.lines %}{{ line }}<br>{% endfor %}<a href="{{ site.office.map }}">Get directions</a></p>
      </div>
    </div>
    <nav class="ftr__cols" aria-label="Footer navigation">
      {% for col in site.footer %}
      <div>
        <h3>{{ col.heading }}</h3>
        <ul>{% for l in col.links %}<li><a href="{{ l.url | url }}">{{ l.label }}</a></li>{% endfor %}</ul>
      </div>
      {% endfor %}
    </nav>
    <div class="ftr__social">
      <div><h3>Follow Lifepoint</h3><p>Stay connected through the week.</p></div>
      <ul>{% for s in site.social %}<li><a href="{{ s.url }}" aria-label="Lifepoint on {{ s.name }}" title="{{ s.name }}">{% if s.name == "Instagram" %}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>{% endif %}{% if s.name == "Facebook" %}<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg>{% endif %}{% if s.name == "YouTube" %}<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3L10 15z"/></svg>{% endif %}</a></li>{% endfor %}</ul>
    </div>
    <p class="ftr__copy">© 2026 Lifepoint Church</p>
  </footer>

  <div class="help">
    <div class="help__panel" id="help" hidden>
      <h3>Hello!</h3>
      <p>How can we help?</p>
      <a href="{{ '/sundays/' | url }}">Sundays</a>
      <a href="{{ '/watch--listen/' | url }}">Watch Messages</a>
      <a href="{{ '/our-team/' | url }}">Email a Pastor</a>
      <a href="{{ '/events/' | url }}">Events</a>
    </div>
    <button class="help__btn" aria-expanded="false" aria-controls="help" aria-label="How can we help?">?</button>
  </div>

  <script src="{{ '/assets/js/site.js' | url }}?v={{ buildId }}" defer></script>
</body>
</html>
