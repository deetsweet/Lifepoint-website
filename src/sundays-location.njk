---
layout: layouts/base.njk
pagination:
  data: locations
  size: 1
  alias: loc
permalink: "/sundays/{{ loc.slug }}/"
heroHeader: true
eleventyComputed:
  title: "Sundays at {{ loc.name }} | Lifepoint Church - Moreton, Queensland"
  description: "Sundays at Lifepoint {{ loc.name }}. {{ loc.venue }}, {{ loc.address }}. Sundays at {{ loc.timesText }}. Come as you are."
ages:
  - { label: Kids, img: sundays-age-kids }
  - { label: Teens, img: sundays-age-teens }
  - { label: Babies, img: sundays-age-babies }
  - { label: Families, img: sundays-age-families }
  - { label: Young adults, img: sundays-age-young-adults }
  - { label: Seniors, img: sundays-age-seniors }
faqs:
  - q: Do I have to be a Christian to come?
    a: "Not at all. Every Sunday we have people who wouldn't call themselves Christian or religious. You're welcome to come, look around and ask questions."
  - q: What happens to my kids?
    a: kids
  - q: How long is a service?
    a: "About 65 minutes. We sing, pray together, hear what's happening around the church and listen to a message from the Bible of around 25 minutes."
  - q: Will I have to do anything?
    a: "Only what you're comfortable with. We'll stand for some songs and prayers and it will always be clear when, but you're free to sit and take it in."
  - q: Do I have to give money?
    a: "No. Giving is for people who call Lifepoint home. As a guest, please don't feel any expectation."
  - q: Do you have communion?
    a: "Yes, every four weeks. Communion, also called the Lord's Supper, is when we share bread and juice to remember Jesus' death for us. Anyone who wants to receive God's grace is welcome to take part, and you're equally welcome to sit it out."
beyond:
  - { title: Watch online, url: "/watch--listen/", text: "Catch up on recent messages any time, wherever you are." }
  - { title: Try Alpha, url: "/alpha/", text: "Food, a short talk and honest conversation about life and faith. Questions welcome." }
  - { title: Next Steps, url: "/next-steps/", text: "Been coming for a little while? Find out more about Lifepoint and how to get connected." }
---
{% import "macros.njk" as m with context %}
{% set other = locations | reject("equalto", loc) | first %}

<section class="hero">
  {{ m.photo(loc.heroImg, "hero__img", true) }}
  <div class="hero__inner">
    {{ m.eyebrow("Lifepoint Church · " + loc.name) }}
    <h1 class="hero__title">Sundays <span class="script">at</span> {{ loc.name }}</h1>
    <div class="hero__foot">
      <p class="hero__intro">{% if loc.note %}<strong>{{ loc.note }}.</strong> {% endif %}{{ loc.intro }}</p>
      <div class="hero__actions">
        <ul class="times">{% for t in loc.times %}<li>{{ t }}</li>{% endfor %}</ul>
        {{ m.pill("Plan your visit", site.planVisit) }}
      </div>
    </div>
  </div>
</section>

<div class="ticker" aria-label="{{ loc.ticker | join(', ') }}">
  <div class="ticker__track" aria-hidden="true">
    {% for round in [1, 2] %}{% for t in loc.ticker %}<span>{{ t }} ✦</span>{% endfor %}{% endfor %}
  </div>
</div>

<section class="sec sec--dark">
  <div class="locwhere">
    <div>
      <h2>Find us</h2>
      <p class="campus__times">Sundays {{ loc.times | join(" · ") }}</p>
      <p><strong>{{ loc.venue }}</strong><br>{{ loc.address }}</p>
      <p class="links">
        <a class="arrow-link" href="{{ loc.maps }}">Google Maps <span aria-hidden="true">→</span></a>
        <a class="arrow-link" href="{{ loc.apple }}">Apple Maps <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <a class="locwhere__other" href="{{ ('/sundays/' + other.slug + '/') | url }}">Looking for {{ other.name }}?<span>Sundays {{ other.times | join(" · ") }} <span aria-hidden="true">→</span></span></a>
  </div>
</section>

<section class="sec">
  <div class="split-head">
    <div>
      {{ m.eyebrow("Every generation") }}
      <h2>One family, every age.</h2>
    </div>
    <p>We're a multigenerational church. On any Sunday you'll see babies and kids, teenagers, young families, single and married adults, and seniors. Everyone has a place here.</p>
  </div>
  <div class="ages">
    {% for a in ages %}
    <figure class="age">{{ m.photo(a.img, "age__img") }}<figcaption>{{ a.label }}</figcaption></figure>
    {% endfor %}
  </div>
</section>

<section class="sec sec--linen">
  <div class="centre-head">
    {{ m.eyebrow("Your first Sunday") }}
    <h2>Here's how it flows.</h2>
  </div>
  <ol class="steps">
    {% for s in loc.steps %}
    <li class="step">
      <div class="step__media">{{ m.photo(s.img, "step__img") }}<span class="step__num">0{{ loop.index }}</span></div>
      <h3>{{ s.title }}</h3>
      <p>{{ s.text }}</p>
    </li>
    {% endfor %}
  </ol>
</section>

<section class="sec welcome">
  <div class="welcome__media">
    {{ m.photo(loc.welcome.img, "welcome__img") }}
    <svg class="welcome__badge" viewBox="0 0 120 120" aria-hidden="true">
      <defs><path id="circ" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
      <circle cx="60" cy="60" r="58" />
      <text><textPath href="#circ">WELCOME HOME · COME AS YOU ARE ·</textPath></text>
      <text class="hi" x="60" y="68" text-anchor="middle">hi!</text>
    </svg>
  </div>
  <div class="welcome__text">
    {{ m.eyebrow(loc.welcome.from) }}
    <blockquote>{{ loc.welcome.quote }}</blockquote>
    <p>{{ loc.welcome.text }}</p>
    <p class="sig"><span class="script">{{ loc.welcome.sig }}</span><span>{{ loc.welcome.role }}</span></p>
  </div>
</section>

<section class="sec sec--linen plan">
  {{ m.photo(loc.planImg, "plan__img") }}
  <div class="plan__text">
    {{ m.eyebrow("Plan your visit") }}
    <h2>Let us know you're coming.</h2>
    <ul class="ticks">
      <li>Someone to meet you at the door</li>
      <li>Help getting your kids settled</li>
      <li>A coffee and a friendly face</li>
    </ul>
    {{ m.pill("Plan your visit", site.planVisit, "dark") }}
  </div>
</section>

<section class="sec sec--nextgen kids">
  <div class="kids__text">
    {{ m.eyebrow("Lifepoint Kids · " + loc.name) }}
    <h2>Your kids will love it here.</h2>
    {% if loc.kids.groups.length %}
    <dl class="groups">
      {% for g in loc.kids.groups %}<div><dt>{{ g[0] }}</dt><dd>{{ g[1] }}</dd></div>{% endfor %}
    </dl>
    {% endif %}
    <ul class="stars">{% for p in loc.kids.points %}<li>{{ p }}</li>{% endfor %}</ul>
    {{ m.pill("Pre-register your kids", site.kidsRego, "dark") }}
  </div>
  <div class="kids__collage">
    {% for i in loc.kids.imgs %}{{ m.photo(i, "collage__img") }}{% endfor %}
  </div>
</section>

<section class="sec sec--dark">
  <div class="centre-head">
    {{ m.eyebrow("Good to know") }}
    <h2>The practical stuff.</h2>
  </div>
  <div class="cards">
    {% for c in loc.practical %}<div class="card"><h3>{{ c.title }}</h3><p>{{ c.text }}</p></div>{% endfor %}
  </div>
</section>

<section class="sec sec--linen faq">
  <div class="faq__head">
    {{ m.eyebrow("Got questions?") }}
    <h2>Good questions.</h2>
    <p>Still wondering about something? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> or call <a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>. A real person will get back to you.</p>
  </div>
  <div class="faq__list">
    {% for f in faqs %}
    <details><summary>{{ f.q }}</summary><p>{% if f.a == "kids" %}{{ loc.kidsFaq }} Check-in opens before the service, or <a href="{{ site.kidsRego }}">pre-register online</a> to skip the forms.{% else %}{{ f.a | safe }}{% endif %}</p></details>
    {% endfor %}
    {% for f in loc.faqExtra %}
    <details><summary>{{ f.q }}</summary><p>{{ f.a | safe }}</p></details>
    {% endfor %}
  </div>
</section>

<section class="sec sec--dark beyond">
  {{ m.photo("sundays-beyond-bg", "beyond__bg") }}
  <div class="centre-head">
    {{ m.eyebrow("Beyond Sunday") }}
    <h2>Can't make it? Want more?</h2>
  </div>
  <div class="beyond__cards">
    {% for b in beyond %}
    <a class="lcard" href="{{ b.url | url }}"><h3>{{ b.title }} <span aria-hidden="true">→</span></h3><p>{{ b.text }}</p></a>
    {% endfor %}
  </div>
</section>

<section class="sec closing">
  {{ m.eyebrow("See you Sunday") }}
  <h2>Your seat<br><span class="script">is saved.</span></h2>
  {{ m.pill("Plan your visit", site.planVisit, "dark") }}
  <p class="closing__line">{{ loc.venue }}, {{ loc.address }} · Sundays {{ loc.timesText }}</p>
</section>
