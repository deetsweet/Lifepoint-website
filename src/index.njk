---
layout: layouts/base.njk
title: Home | Lifepoint Church - Moreton, Queensland
description: Lifepoint Church in Moreton Bay. Sundays at Rothwell (8.30am, 10am and 5pm) and Caboolture West (9.30am). Your place to belong.
permalink: /
heroHeader: true
places:
  - { img: home-hub, title: Lifepoint Hub, sub: "Weekday office<br>&amp; programs space", times: Open Monday to Friday, place: "1 McKillop St, Rothwell", url: "https://maps.app.goo.gl/uBr3D9gFD6uBe15a9", link: Find our Hub }
  - { img: home-rothwell, title: Rothwell, sub: 3 services every Sunday, times: "8.30am | 10am | 5pm", place: "<strong>Grace Lutheran College Chapel</strong><br>Cnr Mewes Rd &amp; Anzac Ave, Rothwell", url: /sundays/rothwell/, link: Plan a visit }
  - { img: home-caboolture-west, title: Caboolture West, sub: "Sundays from<br>7 February 2027", times: 9.30am, place: "<strong>Grace Lutheran College, Caboolture Campus</strong><br>129 Toohey St, Caboolture", url: /sundays/caboolture-west/, link: Plan a visit }
tiles:
  - { img: home-kids-youth, title: "Kids &amp; Youth", text: Find out more about our Lifepoint Kids and Youth programs., links: [{ label: Kids, url: /kids/ }, { label: Youth, url: /youth/ }] }
  - { img: home-programs, title: Programs, text: "Every age and stage of life is different, with its own challenges and joys.", links: [{ label: Learn more, url: /ministries/ }] }
  - { img: home-groups, title: Find a Group, text: "We meet as small groups through the week. Find a group that fits your interests, age and stage of life.", links: [{ label: Find a group, url: /small-groups/ }] }
  - { img: home-messages, title: Messages, text: "Watch and listen to past messages to see what we're like.", links: [{ label: Watch, url: /watch--listen/ }] }
  - { img: home-serve, title: Serve, text: "The best way to find your place is to use your gifts and time on a Lifepoint team, in our mission to see Jesus transform lives.", links: [{ label: Join a team, url: /teams/ }] }
help:
  - { img: home-team, title: Meet the Team, text: Meet our staff and leaders., links: [{ label: About us, url: /our-team/ }] }
  - { img: home-serving-world, title: Serving our World, text: "We serve our local community in Moreton Bay, and the world through partners like Compassion.", links: [{ label: Compassion, url: "https://compassion.com.au" }] }
  - { img: home-faith-steps, title: Faith Steps, text: Interested in taking a step to find out more about God and faith?, links: [{ label: Next steps, url: /next-steps/ }] }
  - { img: home-connect, title: Connect with Us, text: "Let us know what you need and someone from our team will contact you.", links: [{ label: Connect, url: /connect/ }] }
  - { img: p-stage-prayer, title: Prayer, text: Let us know how we can be praying for you., links: [{ label: Prayer, url: /prayer/ }] }
---
{% import "macros.njk" as m with context %}

<section class="hhero">
  <video class="hhero__img" autoplay muted loop playsinline poster="{{ '/assets/img/home-hero-poster.jpg' | url }}"><source src="{{ '/assets/img/home-hero.mp4' | url }}" type="video/mp4"></video>
  <div class="hhero__inner">
    <h1 class="hhero__title">Welcome to Lifepoint <span class="script">your place to belong</span></h1>
    <div class="hhero__foot">
      <ul class="hhero__locs">
        {% for l in locations %}<li><a class="hhero__loc" href="{{ ('/sundays/' + l.slug + '/') | url }}"><strong>{{ l.name }}</strong><span class="times">{% for t in l.times %}<span>{{ t }}</span>{% endfor %}</span><span class="hhero__go" aria-hidden="true">→</span></a></li>{% endfor %}
      </ul>
      <div class="btns">
        <a class="pill pill--blue" href="{{ '/sundays/' | url }}">Plan your Sunday</a>
        <a class="hhero__watch" href="{{ '/watch--listen/' | url }}"><span class="hhero__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>Watch online</a>
      </div>
    </div>
  </div>
</section>

<section class="sec sec--linen hloc">
  <div class="hloc__grid">
    {% for l in places %}
    <a class="hloc__card" href="{{ l.url | url }}">
      {{ m.photo(l.img, "hloc__img") }}
      <div class="hloc__body">
        <h2>{{ l.title }}</h2>
        <p class="hloc__sub">{{ l.sub | safe }}</p>
        <div class="hloc__foot">
          <p class="hloc__times">{{ l.times }}</p>
          <p>{{ l.place | safe }}</p>
          <span class="pill pill--light">{{ l.link }}</span>
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>


<section class="sec sec--linen hletter">
  {{ m.photo("home-dan-steph", "hletter__img") }}
  <p class="hletter__kicker">A message from our Senior Pastor</p>
  <h2>You're welcome in our family</h2>
  <p>Our vision at Lifepoint is to make Jesus known in our region and see thousands of lives transformed by the gospel.</p>
  <p>We believe that every person matters to God, and we invite you to our church no matter what your beliefs, doubts, past or problems.</p>
  <p>In a world where being completely known and being completely accepted are often two separate categories, we believe the strange and shockingly good message of Jesus is exactly what this world needs right now.</p>
  <p>We'd love to see you Sunday.</p>
  <p class="hletter__sig script">Dan and Steph Sweetman</p>
  {{ m.pill("Meet our team", "/our-team/", "dark") }}
</section>

<section class="sec sec--linen hrow" id="explore">
<div class="htiles htiles--scroll">
  {% for t in tiles %}
  <article class="htile">
    {{ m.photo(t.img, "htile__img") }}
    <div class="htile__body">
      <h3>{{ t.title | safe }}</h3>
      <p>{{ t.text }}</p>
      <p class="htile__btns">{% for b in t.links %}<a class="pill pill--light" href="{{ b.url | url }}">{{ b.label }}</a>{% endfor %}</p>
    </div>
  </article>
  {% endfor %}
</div>
</section>


{% include "embeds/home-events.html" %}

<section class="sec sec--linen hhelp">
  <div class="centre-head">
    <h2>Need more help?</h2>
    <p class="lede">Find out more and take the next step.</p>
  </div>
  <div class="htiles htiles--inset htiles--scroll">
    {% for t in help %}
    <article class="htile">
      {{ m.photo(t.img, "htile__img") }}
      <div class="htile__body">
        <h3>{{ t.title | safe }}</h3>
        <p>{{ t.text }}</p>
        <p class="htile__btns">{% for b in t.links %}<a class="pill pill--light" href="{{ b.url | url }}">{{ b.label }}</a>{% endfor %}</p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="hband">
  {{ m.photo("home-see-you-sunday", "hband__img") }}
  <div class="hband__inner">
    <h2>See you Sunday?</h2>
    <p class="hband__note">No church experience required.</p>
    <p>Sundays at Rothwell at 8.30am, 10am and 5pm, and at Caboolture West at 9.30am from 7 February 2027.</p>
    {{ m.pill("Sundays info", "/sundays/", "light") }}
  </div>
</section>
